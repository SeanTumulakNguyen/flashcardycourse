### ❌ INCORRECT: Security Violations

```typescript
// ❌ NEVER check plans/features on the client side only
"use client";
const { user } = useUser();
if (user?.publicMetadata?.plan === 'pro') { // ❌ Don't rely on client-side metadata
  // ...
}

// ❌ NEVER skip server-side validation
"use server";
export async function createDeckAction(input: CreateDeckInput) {
  const { userId } = await auth();
  // ❌ Missing: Check deck limit based on plan/feature
  await createDeck(userId, input);
}

// ❌ NEVER hardcode plan/feature names - use the exact strings defined above
const hasPro = has({ plan: 'premium' }); // ❌ Wrong plan name, use 'pro'
const hasFeature = has({ feature: 'unlimited' }); // ❌ Wrong feature name, use 'unlimited_decks'

// ❌ NEVER trust client-provided plan/feature information
const plan = req.body.plan; // ❌ Always use has() method from auth()
```

